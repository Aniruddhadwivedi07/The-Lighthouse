# =============================================================================
# Lighthouse — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://lighthouse:lighthouse@localhost:5432/lighthouse

# ---------------------------------------------------------------------------
# LLM — Model Adapter
# Set MODEL_PROVIDER to select the backend.
# Supported values: "google_gemini" | "openai" | "ollama"
#
# MODEL_NAME must match the exact model identifier for the chosen provider.
# Examples:
#   google_gemini : "gemini-1.5-flash-latest"  or  "gemma-3-27b-it"  (confirm with track brief)
#   openai        : "gpt-4o-mini"
#   ollama        : "llama3"
#
# If MODEL_PROVIDER is not set, generation endpoints will return a clear
# "no model configured" error rather than silently failing.
# ---------------------------------------------------------------------------
MODEL_PROVIDER=
MODEL_NAME=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Embeddings
# EMBEDDING_MODEL is the sentence-transformers model name used locally.
# No API key is required for local embeddings.
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

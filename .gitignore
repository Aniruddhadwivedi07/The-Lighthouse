# Lighthouse — .gitignore

# Environment and secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.venv
.venv/
venv
venv/
env
env/
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
*.pytest_cache/
.mypy_cache/
.ruff_cache/

# Alembic (keep versions, ignore generated pycache)
backend/data/migrations/__pycache__/

# Frontend
**/node_modules/
apps/web/dist/
apps/web/.vite/
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
logs/

# Docker
.docker/

# Model weights (large binary files — do not commit)
*.bin
*.safetensors
*.gguf
models/
